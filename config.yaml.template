mqtt:
  url: "ssl://broker:8883"
  username: "cam-entree"      # identifiant de la caméra (3-32 car. [A-Za-z0-9_-]) = clientId MQTT
  password: "password"
  # ca: "/etc/ocamera/ca.crt" # CA personnalisé du broker (optionnel ; sinon magasin système)

device:
  name: "Entrée"              # nom affiché dans l'application (défaut : l'identifiant)
  url: "rtsp://ip:554/stream"
  video: "H264"               # H264 | H265
  audio: "PCMU"               # PCMA | PCMU | opus

